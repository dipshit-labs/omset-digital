{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "types": ["bun", "react", "react-dom"],
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["./src/payload/payload.config.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
