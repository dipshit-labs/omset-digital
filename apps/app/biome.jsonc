{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",

  // We need to re-include the base ignore patterns from ultracite plus
  // app-specific ones for PayloadCMS-generated files.
  // * See: https://github.com/haydenbleasel/ultracite/issues/679
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.git",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/payload-types.ts",
      "!!**/next-env.d.ts",

      // PayloadCMS
      "!!**/src/app/(payload)",
      "**/src/app/(payload)/custom.scss"
    ]
  },

  "plugins": [
    "./node_modules/biome-plugin-payload/rules/no-find-without-select.grit",
    "./node_modules/biome-plugin-payload/rules/no-find-without-depth.grit",
    "./node_modules/biome-plugin-payload/rules/no-missing-override-access.grit",
    "./node_modules/biome-plugin-payload/rules/prefer-explicit-populate.grit",
    "./node_modules/biome-plugin-payload/rules/require-user-with-override-false.grit"
  ]
}
