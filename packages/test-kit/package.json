{
  "name": "@repo/test-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./helpers": {
      "types": "./src/helpers.ts",
      "default": "./src/helpers.ts"
    },
    "./msw": {
      "types": "./src/msw/index.ts",
      "default": "./src/msw/index.ts"
    },
    "./msw/setup": {
      "types": "./src/msw/setup.ts",
      "default": "./src/msw/setup.ts"
    },
    "./msw/handlers": {
      "types": "./src/msw/handlers/index.ts",
      "default": "./src/msw/handlers/index.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .next .turbo dist node_modules",
