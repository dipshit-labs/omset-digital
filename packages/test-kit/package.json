    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:types",
    "@types/pg": "^8.20.0",
    "typescript": "catalog:types",
    "vitest": "catalog:test"
  }
}
