{
  "name": "@repo/test-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./msw": {
      "types": "./src/msw/index.ts",
      "default": "./src/msw/index.ts"
    },
    "./msw/setup": {
      "types": "./src/msw/setup.ts",
      "default": "./src/msw/setup.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .next .turbo dist node_modules",
    "test": "vitest run",
    "test:unit": "vitest run --project '*unit*'",
    "test:integration": "vitest run --project '*integration*'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "catalog:payload"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:types",
    "@types/pg": "catalog:types",
    "@vitest/coverage-v8": "catalog:test",
    "typescript": "catalog:types",
    "vitest": "catalog:test"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "catalog:payload",
    "@payloadcms/db-postgres": "catalog:payload",
    "@payloadcms/drizzle": "catalog:payload",
    "drizzle-orm": "catalog:core",
    "msw": "catalog:test",
    "payload": "catalog:payload"
  }
}
