{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./shared.css": "./src/styles/shared.css",
    "./postcss": "./postcss.config.mjs",
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    }
  },
  "scripts": {
    "shadcn": "shadcn",
    "clean": "git clean -xdf .cache .next .turbo dist node_modules",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:ui",
    "class-variance-authority": "catalog:ui",
    "cn": "catalog:ui",
    "shadcn": "catalog:ui",
    "tw-animate-css": "catalog:ui"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:ui",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tailwindcss": "catalog:ui",
    "typescript": "catalog:types"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
