{
  "name": "@repo/commerce-adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./utils": {
      "types": "./src/exports/utils.ts",
      "default": "./src/exports/utils.ts"
    },
    "./payments": {
      "types": "./src/exports/payments.ts",
      "default": "./src/exports/payments.ts"
    },
    "./shipping": {
      "types": "./src/exports/shipping.ts",
      "default": "./src/exports/shipping.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .next .turbo dist node_modules",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.thresholds.statements=80 --coverage.thresholds.branches=80",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsscmp": "catalog:core",
    "zod": "catalog:core"
  },
  "devDependencies": {
    "@repo/test-kit": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:types",
    "@types/tsscmp": "catalog:types",
    "@vitest/coverage-v8": "catalog:test",
    "msw": "catalog:test",
    "typescript": "catalog:types",
    "vitest": "catalog:test"
  }
}
