{
  "name": "omset-digital",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/themes/*"
    ],
    "catalogs": {
      "core": {
        "@t3-oss/env-nextjs": "^0.13.11",
        "tsscmp": "1.0.6",
        "zod": "4.6.5"
      },
      "payload": {
        "@libsql/client": "^0.14.0",
        "@payloadcms/db-postgres": "3.90.2",
        "@payloadcms/db-sqlite": "3.90.2",
        "@payloadcms/email-resend": "3.90.2",
        "@payloadcms/next": "3.90.2",
        "@payloadcms/plugin-multi-tenant": "3.90.2",
        "@payloadcms/plugin-seo": "3.90.2",
        "@payloadcms/richtext-lexical": "3.90.2",
        "@payloadcms/ui": "3.90.2",
        "payload": "3.90.2",
        "sharp": "^0.35.4"
      },
      "react": {
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "babel-plugin-react-compiler": "1.0.0",
        "next": "16.3.3",
        "react": "19.3.0",
        "react-dom": "19.3.0"
      },
      "test": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "5.0.2",
        "fishery": "^2.2.2",
        "jsdom": "^30.1.1",
        "msw": "^3.0.2",
        "vitest": "^5.0.2"
      },
      "tooling": {
        "@shadcn/lint": "^0.2.0",
        "eslint-plugin-perfectionist": "^5.12.1",
        "lefthook": "^2.1.14",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.85.0",
        "turbo": "^2.11.4",
        "ultracite": "7.12.2",
        "knip": "^6.39.0"
      },
      "types": {
        "@types/bun": "^1.4.0",
        "@types/node": "24",
        "@types/tsscmp": "^1.0.2",
        "typescript": "7.0.2"
      },
      "ui": {
        "@base-ui/react": "^1.8.0",
        "@tailwindcss/postcss": "4.3.3",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "shadcn": "^4.21.0",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "^1.4.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/run-with-log.ts dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "check": "ultracite check --deny-warnings --report-unused-disable-directives",
    "fix": "ultracite fix",
    "knip": "knip --cache --treat-config-hints-as-errors",
    "clean": "turbo run clean && git clean -xdf .cache .turbo node_modules",
    "shadcn": "bun --filter @repo/ui shadcn",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@shadcn/lint": "catalog:tooling",
    "@types/bun": "catalog:types",
    "@vitest/coverage-v8": "catalog:test",
    "eslint-plugin-perfectionist": "catalog:tooling",
    "knip": "catalog:tooling",
    "lefthook": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:types",
    "ultracite": "catalog:tooling",
    "vitest": "catalog:test"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.0"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
