{
  "name": "omset-digital",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/themes/*"
    ],
    "catalog": {
      "typescript": "7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "dev": "turbo run dev",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "turbo": "^2.10.13",
    "typescript": "catalog:",
    "ultracite": "7.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
