{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.env.test",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!test/**",
        "!vitest.config.*",
        "!README.md",
        "!AGENTS.md"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "typecheck": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", ".env.test"],
      "env": ["DATABASE_URL"]
    },
    "test:unit": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", ".env.test", "!test/integrations/**"]
    },
    "test:integration": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", ".env.test"],
      "env": ["DATABASE_URL"]
    },
    "test:coverage": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", ".env.test"],
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "//#clean": { "cache": false },
    "clean": { "cache": false },
    "topo": { "dependsOn": ["^topo"] }
  }
}
