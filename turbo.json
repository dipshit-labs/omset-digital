{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!vitest.config.*",
        "!README.md",
        "!AGENTS.md"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "PAYLOAD_SECRET",
        "RESEND_API_KEY",
        "PAYLOAD_SEED",
        "NEXT_PUBLIC_SERVER_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env.test", "!test/integrations/**"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env.test"],
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env.test"],
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env.test"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "clean": {
      "cache": false
    }
  }
}
